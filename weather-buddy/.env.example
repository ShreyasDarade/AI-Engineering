# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: pick a different model (default: claude-sonnet-5)
# WEATHER_BUDDY_MODEL=claude-opus-5

# Optional: skip the live Open-Meteo API and use built-in demo cities.
# Handy on a locked-down network, on a plane, or in tests.
# WEATHER_BUDDY_OFFLINE=1
