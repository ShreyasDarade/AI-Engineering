# ---------------------------------------------------------------------------
# Everything here is OPTIONAL. Out of the box the bot runs in free mode:
# no LLM, no API key, no account, no charges.
# ---------------------------------------------------------------------------

# Only needed if you run `python -m weather_buddy --llm`.
# That mode sends messages to the Anthropic API and IS billed to your account.
# Leave this unset and nothing can ever be charged.
# ANTHROPIC_API_KEY=sk-ant-...

# Which model --llm uses (default: claude-sonnet-5)
# WEATHER_BUDDY_MODEL=claude-opus-5

# Set to 1 to skip the Open-Meteo API entirely and use six built-in cities.
# Open-Meteo is free and keyless, but this makes the bot fully offline.
# WEATHER_BUDDY_OFFLINE=1
